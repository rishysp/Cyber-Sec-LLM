# Orchestrator image: LangGraph router + hybrid retrieval + OpenAI-compatible API (stage5/server.py).
# CPU only - the GPU belongs to vLLM. Built once with internet (pip), then runs fully offline.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 ANONYMIZED_TELEMETRY=False HOME=/tmp
WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt
COPY app/ /app/
EXPOSE 8100
CMD ["python", "server.py", "--host", "0.0.0.0", "--port", "8100"]
